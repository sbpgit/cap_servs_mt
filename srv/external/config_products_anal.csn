    "SHIP_FROM_LOC": {
     "type": "cds.String",
     "length": 4,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Ship from Location"
    },
    "CHANGED_DATE": {
     "type": "cds.Date",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Changed Date",
     "@sap.display.format": "Date"
    },
    "CHANGED_BY": {
     "type": "cds.String",
     "length": 12,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Changed By"
    },
    "CREATED_DATE": {
     "type": "cds.Date",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Created Date",
     "@sap.display.format": "Date"
    },
    "CREATED_BY": {
     "type": "cds.String",
     "length": 12,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Created By"
    },
    "CHANGED_TIME": {
     "type": "cds.Time",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Changed Time"
    },
    "CREATED_TIME": {
     "type": "cds.Time",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Created Time"
    },
    "RESERVE_FIELD1": {
     "type": "cds.String",
     "length": 40,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Reserve Field 1"
    },
    "RESERVE_FIELD2": {
     "type": "cds.String",
     "length": 40,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Reserve Field 2"
    },
    "RESERVE_FIELD3": {
     "type": "cds.String",
     "length": 40,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Reserve Field 3"
    },
    "RESERVE_FIELD4": {
     "type": "cds.String",
     "length": 40,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Reserve Field 4"
    },
    "RESERVE_FIELD5": {
     "type": "cds.String",
     "length": 40,
     "@sap.aggregation.role": "dimension",
