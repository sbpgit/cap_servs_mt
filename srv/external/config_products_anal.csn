    "LOCATION_ID": {
     "type": "cds.String",
     "length": 4,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Demand Location"
    },
    "SALE_LOCATION": {
     "type": "cds.String",
     "length": 4,
