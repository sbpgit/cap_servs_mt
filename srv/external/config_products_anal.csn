  "config_products_anal.getWeeklySalesData": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.semantics": "aggregate",
   "elements": {
    "ID__": {
     "key": true,
     "type": "cds.LargeString",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "SALES_DOC": {
     "type": "cds.String",
     "length": 10,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Sales Doc."
    },
    "SALESDOC_ITEM": {
     "type": "cds.String",
     "length": 10,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "SalesDoc. Item"
    },
    "REF_PRODID": {
     "type": "cds.String",
     "length": 40,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Config Products"
    },
    "PRODUCT_ID": {
     "type": "cds.String",
     "length": 40,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Product ID"
    },
    "UNIQUE_ID": {
     "type": "cds.Integer",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Unique ID"
    },
    "PRIMARY_ID": {
     "type": "cds.Integer",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Primary ID"
    },
