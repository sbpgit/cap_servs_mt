     "@sap.label": "Doc. Created Date",
     "@sap.display.format": "Date"
    },
    "SCHEDULELINE_NUM": {
     "type": "cds.String",
     "length": 4,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Schedule Line Number"
    },
    "REASON_REJ": {
     "type": "cds.String",
     "length": 2,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Reason Rej"
    },
    "UOM": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "UOM"
    },
    "CONFIRMED_QTY": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@sap.aggregation.role": "measure",
     "@sap.label": "Confirmed Qty."
    },
    "ORD_QTY": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
