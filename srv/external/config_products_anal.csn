     "type": "cds.String",
     "length": 4,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Sales Org"
    },
    "DISTR_CHANNEL": {
     "type": "cds.String",
     "length": 2,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "DISTR Channel"
    },
    "DIVISION": {
     "type": "cds.String",
     "length": 2,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Division"
    },
    "SAL_DOCU_TYPE": {
     "type": "cds.String",
     "length": 4,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Sales Doc Type"
    },
    "ITEM_CREATED_DATE": {
     "type": "cds.Date",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Item Created Date",
     "@sap.display.format": "Date"
    },
    "ITEM_CHANGE_DATE": {
     "type": "cds.Date",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Item Change Date",
     "@sap.display.format": "Date"
    },
    "IBP_CUSTOMER": {
     "type": "cds.String",
     "length": 10,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "IBP Customer"
    },
    "RELEVENT_FOR_PLAN": {
     "type": "cds.String",
     "length": 1,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Relevent For Plan"
    },
    "ON_HAND_STOCK": {
     "type": "cds.String",
     "length": 1,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "On Hand Stock"
    },
    "IN_TRANSIT": {
     "type": "cds.String",
     "length": 1,
