     "type": "cds.String",
     "length": 100,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Characteristic ID",
     "notNull": true
    },
    "CHARVAL_NUM": {
     "type": "cds.String",
     "length": 80,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Characteristic Value ID",
     "notNull": true
    },
    "CHAR_DESC": {
     "type": "cds.String",
     "length": 160,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Characteristic Description"
    },
    "CHAR_NAME": {
     "type": "cds.String",
     "length": 80,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Characteristic Name"
    },
    "CHARVAL_DESC": {
     "type": "cds.String",
     "length": 160,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Characteristic Value Description"
    },
    "MODEL_VERSION": {
     "type": "cds.String",
     "length": 20,
     "@sap.label": "Model Verison"
    },
    "VERSION": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Version"
    },
    "SCENARIO": {
     "type": "cds.String",
     "length": 32,
     "@sap.label": "Scenario"
    },
    "VERSION_NAME": {
     "type": "cds.String",
     "length": 50,
     "@sap.label": "Version Name"
    },
    "SCENARIO_NAME": {
     "type": "cds.String",
     "length": 50,
     "@sap.label": "Scenario Name"
    },
    "WEEK_PERIODDESC": {
     "type": "cds.String",
     "length": 50,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Period Desc"
    },
    "LOCATION_DESC": {
     "type": "cds.String",
     "length": 30,
     "@sap.label": "Location Description"
    },
    "PROD_DESC": {
     "type": "cds.String",
     "length": 40,
     "@sap.label": "Product Description"
    },
    "WEEK_DATE": {
     "type": "cds.Date",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Week Date",
     "@sap.display.format": "Date"
    },
    "YEAR": {
     "type": "cds.Integer",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Week Date Year"
    },
    "QUARTER": {
     "type": "cds.String",
     "length": 7,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Week Date Quarter"
    },
    "MONTH": {
     "type": "cds.LargeString",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Week Date Month"
    },
    "TYPE": {
     "type": "cds.String",
     "length": 1,
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Type",
     "notNull": true
    },
    "QUANTITY": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@sap.aggregation.role": "measure",
     "@sap.label": "Quantity"
    },
    "ACTUAL_QTY": {
     "type": "cds.Decimal",
     "precision": 18,
     "scale": 3,
     "@sap.aggregation.role": "measure",
     "@sap.label": "Actual Quantity"
    },
    "PERCENTAGE": {
     "type": "cds.Decimal",
     "precision": 18,
     "scale": 3,
     "@sap.aggregation.role": "measure",
     "@sap.label": "Percentage"
    },
    "FORECAST_SALES_PERCENTAGE": {
     "type": "cds.Decimal",
     "precision": 18,
     "scale": 3,
     "@sap.aggregation.role": "measure",
     "@sap.label": "Forecast Sales Percent"
    },
    "YEAR_MONTH": {
     "type": "cds.LargeString",
     "@sap.aggregation.role": "dimension",
     "@sap.label": "Year Month"
    }
   }
  },
