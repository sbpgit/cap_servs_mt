        <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
    </edmx:Reference>
    <edmx:DataServices m:DataServiceVersion="2.0">
        <Schema Namespace="CatalogService" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
            <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="getAlertLogs" EntityType="CatalogService.getAlertLogs"/>
                <EntitySet Name="getApplications" EntityType="CatalogService.getApplications"/>
                <EntitySet Name="getMessageGroups" EntityType="CatalogService.getMessageGroups"/>
                <EntitySet Name="maintainAlerts" EntityType="CatalogService.maintainAlerts"/>
                <EntitySet Name="getPlannerAlerts" EntityType="CatalogService.getPlannerAlerts"/>
                <EntitySet Name="getLocations" EntityType="CatalogService.getLocations"/>
                <EntitySet Name="getProducts" EntityType="CatalogService.getProducts"/>
                <FunctionImport Name="getfactorylocdesc" ReturnType="Edm.String" m:HttpMethod="GET"/>
                <FunctionImport Name="maintainAlertLogs" ReturnType="Edm.String" m:HttpMethod="POST">
                    <Parameter Name="FLAG" Type="Edm.String" Mode="In" Nullable="true"/>
                    <Parameter Name="USERNAME" Type="Edm.String" Mode="In" Nullable="true"/>
                    <Parameter Name="OBJ" Type="Edm.String" Mode="In" Nullable="true"/>
                </FunctionImport>
                <FunctionImport Name="purgeAlerts" ReturnType="Edm.String" m:HttpMethod="POST"/>
            </EntityContainer>
            <EntityType Name="getAlertLogs">
                <Key>
                    <PropertyRef Name="LOG_ID"/>
                    <PropertyRef Name="APPL"/>
                    <PropertyRef Name="MSGID"/>
                    <PropertyRef Name="MSGGRP"/>
                </Key>
                <Property Name="LOG_ID" Type="Edm.Int32" Nullable="false"/>
                <Property Name="APPL" Type="Edm.String" MaxLength="100" Nullable="false"/>
                <Property Name="MSGID" Type="Edm.String" MaxLength="3" Nullable="false"/>
                <Property Name="MSGGRP" Type="Edm.String" MaxLength="20" Nullable="false"/>
                <Property Name="EXP_DATE" Type="Edm.DateTime" sap:display-format="Date"/>
                <Property Name="LOCATION_ID" Type="Edm.String" MaxLength="4"/>
                <Property Name="PRODUCT_ID" Type="Edm.String" MaxLength="40"/>
                <Property Name="MSGTXT" Type="Edm.String"/>
                <Property Name="PARA1" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA2" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA3" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA4" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA5" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA6" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA7" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA8" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA9" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA10" Type="Edm.String" MaxLength="100"/>
                <Property Name="CREATED_BY" Type="Edm.String"/>
                <Property Name="CREATED_TIME" Type="Edm.DateTimeOffset" Precision="7"/>
                <Property Name="LOGMSG" Type="Edm.String"/>
                <Property Name="MSGTYP" Type="Edm.String" MaxLength="1"/>
            </EntityType>
            <EntityType Name="getApplications">
                <Key>
                    <PropertyRef Name="NAME"/>
                </Key>
                <Property Name="NAME" Type="Edm.String" MaxLength="100" Nullable="false"/>
                <Property Name="DESCRIPTION" Type="Edm.String" MaxLength="100"/>
            </EntityType>
            <EntityType Name="getMessageGroups">
                <Key>
