<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
    <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Capabilities.V1.xml">
        <edmx:Include Alias="Capabilities" Namespace="Org.OData.Capabilities.V1"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
        <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema Namespace="CatalogService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
            <Annotation Term="Core.Links">
                <Collection>
                    <Record>
                        <PropertyValue Property="rel" String="author"/>
                        <PropertyValue Property="href" String="https://cap.cloud.sap"/>
                    </Record>
                </Collection>
            </Annotation>
            <EntityContainer Name="EntityContainer">
                <EntitySet Name="getAlertLogs" EntityType="CatalogService.getAlertLogs"/>
                <EntitySet Name="getApplications" EntityType="CatalogService.getApplications"/>
                <EntitySet Name="getMessageGroups" EntityType="CatalogService.getMessageGroups"/>
                <EntitySet Name="maintainAlerts" EntityType="CatalogService.maintainAlerts"/>
                <EntitySet Name="getPlannerAlerts" EntityType="CatalogService.getPlannerAlerts"/>
                <EntitySet Name="getLocations" EntityType="CatalogService.getLocations"/>
                <EntitySet Name="getProducts" EntityType="CatalogService.getProducts"/>
                <FunctionImport Name="getfactorylocdesc" Function="CatalogService.getfactorylocdesc"/>
                <ActionImport Name="maintainAlertLogs" Action="CatalogService.maintainAlertLogs"/>
                <ActionImport Name="purgeAlerts" Action="CatalogService.purgeAlerts"/>
                <ActionImport Name="upsertAlertLog" Action="CatalogService.upsertAlertLog"/>
            </EntityContainer>
            <EntityType Name="getAlertLogs">
                <Key>
                    <PropertyRef Name="LOG_ID"/>
                    <PropertyRef Name="APPL"/>
                    <PropertyRef Name="MSGID"/>
                    <PropertyRef Name="MSGGRP"/>
                </Key>
                <Property Name="LOG_ID" Type="Edm.Int32" Nullable="false"/>
                <Property Name="APPL" Type="Edm.String" MaxLength="100" Nullable="false"/>
                <Property Name="MSGID" Type="Edm.String" MaxLength="3" Nullable="false"/>
                <Property Name="MSGGRP" Type="Edm.String" MaxLength="20" Nullable="false"/>
                <Property Name="EXP_DATE" Type="Edm.Date"/>
                <Property Name="LOCATION_ID" Type="Edm.String" MaxLength="4"/>
                <Property Name="PRODUCT_ID" Type="Edm.String" MaxLength="40"/>
                <Property Name="MSGTXT" Type="Edm.String"/>
                <Property Name="PARA1" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA2" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA3" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA4" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA5" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA6" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA7" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA8" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA9" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA10" Type="Edm.String" MaxLength="100"/>
                <Property Name="CREATED_BY" Type="Edm.String"/>
                <Property Name="CREATED_TIME" Type="Edm.DateTimeOffset" Precision="7"/>
                <Property Name="LOGMSG" Type="Edm.String"/>
                <Property Name="MSGTYP" Type="Edm.String" MaxLength="1"/>
            </EntityType>
            <EntityType Name="getApplications">
                <Key>
                    <PropertyRef Name="NAME"/>
                </Key>
                <Property Name="NAME" Type="Edm.String" MaxLength="100" Nullable="false"/>
                <Property Name="DESCRIPTION" Type="Edm.String" MaxLength="100"/>
            </EntityType>
            <EntityType Name="getMessageGroups">
                <Key>
                    <PropertyRef Name="GROUP"/>
                </Key>
                <Property Name="GROUP" Type="Edm.String" MaxLength="100" Nullable="false"/>
                <Property Name="DESCRIPTION" Type="Edm.String" MaxLength="100"/>
            </EntityType>
            <EntityType Name="maintainAlerts">
                <Key>
                    <PropertyRef Name="APPL"/>
                    <PropertyRef Name="MSGID"/>
                    <PropertyRef Name="MSGGRP"/>
                </Key>
                <Property Name="APPL" Type="Edm.String" MaxLength="100" Nullable="false"/>
                <Property Name="MSGID" Type="Edm.String" MaxLength="3" Nullable="false"/>
                <Property Name="MSGGRP" Type="Edm.String" MaxLength="20" Nullable="false"/>
                <Property Name="MSGTYP" Type="Edm.String" MaxLength="1"/>
                <Property Name="MSGTXT" Type="Edm.String" MaxLength="120"/>
                <Property Name="MSGDESC" Type="Edm.String"/>
                <Property Name="VALID_DAYS" Type="Edm.Int32"/>
                <Property Name="LOCATION_ID" Type="Edm.String" MaxLength="4"/>
                <Property Name="PRODUCT_ID" Type="Edm.String" MaxLength="40"/>
                <Property Name="PARA1" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA2" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA3" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA4" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA5" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA6" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA7" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA8" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA9" Type="Edm.String" MaxLength="100"/>
                <Property Name="PARA10" Type="Edm.String" MaxLength="100"/>
                <Property Name="DEFAULT" Type="Edm.String" MaxLength="1"/>
                <Property Name="ACTIVE" Type="Edm.Boolean"/>
            </EntityType>
            <EntityType Name="getPlannerAlerts">
                <Key>
                    <PropertyRef Name="LOG_ID"/>
                    <PropertyRef Name="APPL"/>
                    <PropertyRef Name="MSGID"/>
                    <PropertyRef Name="MSGGRP"/>
                    <PropertyRef Name="LOCATION_ID"/>
                    <PropertyRef Name="PRODUCT_ID"/>
                    <PropertyRef Name="SUCCESS_COUNT"/>
                    <PropertyRef Name="ERROR_COUNT"/>
                    <PropertyRef Name="WARNING_COUNT"/>
                </Key>
                <Property Name="LOG_ID" Type="Edm.Int32" Nullable="false"/>
                <Property Name="APPL" Type="Edm.String" Nullable="false"/>
                <Property Name="MSGID" Type="Edm.String" MaxLength="3" Nullable="false"/>
                <Property Name="MSGGRP" Type="Edm.String" MaxLength="20" Nullable="false"/>
                <Property Name="LOCATION_ID" Type="Edm.String" MaxLength="4" Nullable="false"/>
                <Property Name="PRODUCT_ID" Type="Edm.String" MaxLength="40" Nullable="false"/>
                <Property Name="MSGTXT" Type="Edm.String"/>
                <Property Name="SUCCESS_COUNT" Type="Edm.Int32" Nullable="false"/>
                <Property Name="ERROR_COUNT" Type="Edm.Int32" Nullable="false"/>
                <Property Name="WARNING_COUNT" Type="Edm.Int32" Nullable="false"/>
                <Property Name="MESSAGE" Type="Edm.String" MaxLength="120"/>
            </EntityType>
            <EntityType Name="getLocations">
                <Key>
                    <PropertyRef Name="LOCATION_ID"/>
                </Key>
                <Property Name="LOCATION_ID" Type="Edm.String" MaxLength="4" Nullable="false"/>
            </EntityType>
            <EntityType Name="getProducts">
                <Key>
                    <PropertyRef Name="PRODUCT_ID"/>
                </Key>
                <Property Name="PRODUCT_ID" Type="Edm.String" MaxLength="40" Nullable="false"/>
            </EntityType>
            <Function Name="getfactorylocdesc" IsBound="false" IsComposable="false">
                <ReturnType Type="Edm.String"/>
            </Function>
            <Action Name="maintainAlertLogs" IsBound="false">
                <Parameter Name="FLAG" Type="Edm.String"/>
                <Parameter Name="USERNAME" Type="Edm.String"/>
                <Parameter Name="OBJ" Type="Edm.String"/>
                <ReturnType Type="Edm.String"/>
            </Action>
            <Action Name="purgeAlerts" IsBound="false">
                <ReturnType Type="Edm.String"/>
            </Action>
            <Action Name="upsertAlertLog" IsBound="false">
                <ReturnType Type="Edm.String"/>
            </Action>
            <Annotations Target="CatalogService.EntityContainer/getAlertLogs">
                <Annotation Term="Capabilities.DeleteRestrictions">
                    <Record Type="Capabilities.DeleteRestrictionsType">
                        <PropertyValue Property="Deletable" Bool="false"/>
                    </Record>
                </Annotation>
                <Annotation Term="Capabilities.InsertRestrictions">
                    <Record Type="Capabilities.InsertRestrictionsType">
                        <PropertyValue Property="Insertable" Bool="false"/>
                    </Record>
                </Annotation>
                <Annotation Term="Capabilities.UpdateRestrictions">
                    <Record Type="Capabilities.UpdateRestrictionsType">
                        <PropertyValue Property="Updatable" Bool="false"/>
                    </Record>
                </Annotation>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/LOG_ID">
                <Annotation Term="Common.Label" String="Log ID"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/APPL">
                <Annotation Term="Common.Label" String="Application Name"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/MSGID">
                <Annotation Term="Common.Label" String="Message ID"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/MSGGRP">
                <Annotation Term="Common.Label" String="Message Group"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/EXP_DATE">
                <Annotation Term="Common.Label" String="Expiry Date"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/LOCATION_ID">
                <Annotation Term="Common.Label" String="Location"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/PRODUCT_ID">
                <Annotation Term="Common.Label" String="Product"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/MSGTXT">
                <Annotation Term="Common.Label" String="Message Text"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/CREATED_BY">
                <Annotation Term="Common.Label" String="Created By"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/CREATED_TIME">
                <Annotation Term="Common.Label" String="Created Time"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/LOGMSG">
                <Annotation Term="Common.Label" String="Log Message"/>
            </Annotations>
            <Annotations Target="CatalogService.getAlertLogs/MSGTYP">
                <Annotation Term="Common.Label" String="Message Type"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/APPL">
                <Annotation Term="Common.Label" String="Application Name"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/MSGID">
                <Annotation Term="Common.Label" String="Message ID"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/MSGGRP">
                <Annotation Term="Common.Label" String="Message Group"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/MSGTYP">
                <Annotation Term="Common.Label" String="Message Type"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/MSGTXT">
                <Annotation Term="Common.Label" String="Message Text"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/MSGDESC">
                <Annotation Term="Common.Label" String="Message Description"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/VALID_DAYS">
                <Annotation Term="Common.Label" String="Validity Days"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/LOCATION_ID">
                <Annotation Term="Common.Label" String="Location"/>
            </Annotations>
            <Annotations Target="CatalogService.maintainAlerts/PRODUCT_ID">
                <Annotation Term="Common.Label" String="Product"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/APPL">
                <Annotation Term="Common.Label" String="Application Name"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/MSGID">
                <Annotation Term="Common.Label" String="Message ID"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/MSGGRP">
                <Annotation Term="Common.Label" String="Message Group"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/LOCATION_ID">
                <Annotation Term="Common.Label" String="Location"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/PRODUCT_ID">
                <Annotation Term="Common.Label" String="Product"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/MSGTXT">
                <Annotation Term="Common.Label" String="Message Text"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/SUCCESS_COUNT">
                <Annotation Term="Common.Label" String="Success Jobs Count"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/ERROR_COUNT">
                <Annotation Term="Common.Label" String="Error Jobs Count"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/WARNING_COUNT">
                <Annotation Term="Common.Label" String="Warning Jobs Count"/>
            </Annotations>
            <Annotations Target="CatalogService.getPlannerAlerts/MESSAGE">
                <Annotation Term="Common.Label" String="Message"/>
            </Annotations>
        </Schema>
    </edmx:DataServices>
