  "alerts.getAlertLogs": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "LOG_ID": {
     "key": true,
     "type": "cds.Integer",
     "notNull": true,
     "@Common.Label": "Log ID"
    },
    "APPL": {
     "key": true,
     "type": "cds.String",
     "length": 100,
     "notNull": true,
     "@Common.Label": "Application Name"
    },
    "MSGID": {
     "key": true,
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.Label": "Message ID"
    },
    "MSGGRP": {
     "key": true,
     "type": "cds.String",
     "length": 20,
     "notNull": true,
     "@Common.Label": "Message Group"
    },
    "EXP_DATE": {
     "type": "cds.Date",
     "@Common.Label": "Expiry Date"
    },
    "LOCATION_ID": {
     "type": "cds.String",
     "length": 4,
     "@Common.Label": "Location"
    },
    "PRODUCT_ID": {
     "type": "cds.String",
     "length": 40,
     "@Common.Label": "Product"
    },
    "MSGTXT": {
     "type": "cds.String",
     "@Common.Label": "Message Text"
    },
    "PARA1": {
     "type": "cds.String",
     "length": 100
    },
    "PARA2": {
     "type": "cds.String",
     "length": 100
    },
    "PARA3": {
     "type": "cds.String",
     "length": 100
