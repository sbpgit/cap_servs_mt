    "PARA5": {
     "type": "cds.String",
     "length": 100
    },
    "PARA6": {
     "type": "cds.String",
     "length": 100
    },
    "PARA7": {
     "type": "cds.String",
     "length": 100
    },
    "PARA8": {
     "type": "cds.String",
     "length": 100
    },
    "PARA9": {
     "type": "cds.String",
     "length": 100
    },
    "PARA10": {
     "type": "cds.String",
     "length": 100
    },
    "CREATED_BY": {
     "type": "cds.String",
     "@Common.Label": "Created By"
    },
    "CREATED_TIME": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@Common.Label": "Created Time"
    },
    "LOGMSG": {
     "type": "cds.String",
     "@Common.Label": "Log Message"
    },
    "MSGTYP": {
     "type": "cds.String",
     "length": 1,
     "@Common.Label": "Message Type"
    }
   },
   "@Capabilities.DeleteRestrictions.Deletable": false,
   "@Capabilities.InsertRestrictions.Insertable": false,
   "@Capabilities.UpdateRestrictions.Updatable": false
  },
