            "@cds.persistence.skip": true,
            "elements": {
                "TYPE": {
                    "key": true,
                    "type": "cds.String",
                    "length": 100,
                    "notNull": true,
                    "@Common.Label": "Type of Data"
                },
                "CREATED_DATE_TIME": {
                    "key": true,
                    "type": "cds.Timestamp",
                    "@odata.Precision": 7,
                    "@odata.Type": "Edm.DateTimeOffset",
                    "notNull": true,
                    "@Common.Label": "Created Timestamp",
                    "@Core.ComputedDefaultValue": true
                },
                "LOCATION_ID": {
                    "type": "cds.String",
                    "length": 4,
                    "@Common.Label": "Location"
                },
                "PRODUCT_ID": {
                    "type": "cds.String",
                    "length": 40,
                    "@Common.Label": "Product"
                },
                "DATA": {
                    "type": "cds.LargeString",
                    "@Common.Label": "Data"
                },
                "COMMENTS": {
                    "type": "cds.LargeString",
                    "@Common.Label": "Comments"
                },
                "REASON": {
                    "type": "cds.LargeString",
                    "default": {
                        "val": ""
                    },
                    "@Common.Label": "Reason for rejection"
                },
                "STATUS": {
                    "type": "cds.String",
                    "length": 1,
                    "default": {
                        "val": ""
                    },
                    "@Common.Label": "Status"
                }
            }
        },
