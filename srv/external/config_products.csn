        "config_products.cp_ds_seedorddata": {
            "kind": "type",
            "@cds.external": true,
            "elements": {
                "SEED_ORDER": {
                    "type": "cds.String",
                    "length": 10
                },
                "LOCATION_ID": {
                    "type": "cds.String",
                    "length": 4
                },
                "PRODUCT_ID": {
                    "type": "cds.String",
                    "length": 40
                },
                "CUSTOMER_GROUP": {
                    "type": "cds.String",
                    "length": 20
                },
                "UNIQUE_ID": {
                    "type": "cds.Integer"
                },
                "ORD_QTY": {
                    "type": "cds.Decimal",
                    "precision": 13,
                    "scale": 3
                },
                "MAT_AVAILDATE": {
                    "type": "cds.Date"
                },
                "UNIQUE_DESC": {
                    "type": "cds.String",
                    "length": 100
                },
                "EX_IDENTIFICATION": {
                    "type": "cds.String",
                    "length": 40
                }
            }
        },
        "config_products.cp_ds_seedordErrorLog": {
            "kind": "type",
            "@cds.external": true,
            "elements": {
                "ID": {
                    "type": "cds.String",
                    "length": 20
                },
                "LOCATION_ID": {
                    "type": "cds.String",
                    "length": 4
                },
                "PRODUCT_ID": {
                    "type": "cds.String",
                    "length": 40
                },
                "CUSTOMER_GROUP": {
                    "type": "cds.String",
                    "length": 20
                },
                "UNIQUE_ID": {
                    "type": "cds.Integer"
                },
                "ERROR": {
                    "type": "cds.String",
                    "length": 40
                },
                "CREATED_DATE": {
                    "type": "cds.Date"
                }
            }
        },
